{
  "manifest_version": 2,
  "name": "Universal Ad Blocker",
  "version": "2.5",
  "description": "Removes Google, LinkedIn, YouTube, Reddit, Twitter/X, overlay, banner, and various video ads from all websites",
  "author": "Andrii Povkh",
  
  "permissions": [
    "<all_urls>",
    "webRequest",
    "webRequestBlocking"
  ],
  
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "run_at": "document_start",
      "all_frames": true
    }
  ],
  
  "background": {
    "scripts": ["background.js"]
  },
  
  "icons": {
    "48": "icon48.png",
    "96": "icon96.png"
  },
  
  "browser_specific_settings": {
    "gecko": {
      "id": "andrii.povkh@gmail.com",
      "strict_min_version": "142.0",
      "data_collection_permissions": {
        "required": ["none"]
      }
    }
  }
}